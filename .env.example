# =============================================
# LiteLLM 設定（助教提供，用於 Chat Completion）
# =============================================
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_BASE_URL=https://your-litellm-endpoint/

# =============================================
# Embedding Model 設定（sentence-transformers 本地模型，完全免費）
# 首次執行自動下載模型（約 420MB），無需 API Key
# =============================================
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Vector DB 設定（FAISS，不需要 Docker 或 server）
# =============================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=ai_tech_knowledge
